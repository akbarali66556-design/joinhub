# ---- JoinHub config ----
# Is file ko copy karke .env bana lo aur values bharo.

# Server port (Render/Railway khud set karte hain; local ke liye 3000 theek hai)
PORT=3000

# Live site ka URL (deploy ke baad hosting jo URL de, wo yahan daalo). Local me khali chhod do.
PUBLIC_URL=

# Dashboard login key (ise strong rakho)
ADMIN_PASSWORD=change-me-123

# Ek Telegram bot token (@BotFather se banao). Khali rahe to DEMO mode chalega.
# Ye bot HAR client ke channel me ADMIN hona chahiye ("Invite via link" permission ke saath).
TELEGRAM_BOT_TOKEN=

# Invite link kitni der valid rahe (minute)
INVITE_LINK_TTL_MINUTES=120

# Join request auto-approve kare? (true = bot khud approve kar dega)
AUTO_APPROVE=true

# Join hone par user ko welcome message (khali = kuch nahi)
WELCOME_MESSAGE=

# Meta Graph API version
META_API_VERSION=v23.0

# Permanent storage (Upstash Redis — free). Khali rahe to local file (Render par reset ho sakta hai).
# upstash.com se banao, "REST API" me se ye do copy karo:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NOTE: Har client ka apna Meta Pixel ID + Access Token + Telegram channel
# dashboard se add hota hai (yahan nahi).
